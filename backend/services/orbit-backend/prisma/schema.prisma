generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // change if needed
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vendor {
  id               String   @id @default(uuid())
  name             String
  description      String?
  type             String?
  industry         String?
  authType         String?
  clientId         String?
  clientSecret     String?
  authorizationUrl String?
  tokenUrl         String?
  redirectUri      String?
  tokenType        String?
  apiToken         String?
  jwtToken         String?
  certificate      String?
  publicKey        String?
  privateKey       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Parameter {
  id           String   @id @default(uuid())
  name         String
  vendors      String?
  variableType String?
  pinType      String?
  pinCount     Int      @default(0)
  isConstant   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ItemType {
  id          String   @id @default(uuid())
  name        String
  description String?
  synonyms    String?
  vendorName  String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Communication {
  id                           String   @id @default(uuid())
  name                         String
  groupName                    String
  itemType                     String
  protocol                     String
  version                      String?
  messageFormat                String
  communicationMethod          String?
  centric                      String
  messageStructure             String?
  confirmationMessageStructure String?
  icon                         String
  needFirmware                 Boolean  @default(false)
  needConfirmation             Boolean  @default(false)
  format                       String?
  transport                    String?
  metadata                     String?
  image                        String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model Message {
  id                        String   @id @default(uuid())
  name                      String?
  itemType                  String
  communicationPolicy       String
  topic                     String
  messageType               String?
  commandType               String?
  policyType                String?
  communicationMethod       String?
  topicUnique               Boolean  @default(false)
  isPayloadCentric          Boolean  @default(false)
  retainMessages            Boolean  @default(false)
  loggedMessage             Boolean  @default(false)
  qos                       Int?
  pollingInterval           Int?
  requestPayloadFormat      String?
  responsePayloadFormat     String?
  payloadFormat             String?
  confirmationPayloadFormat String?
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Item {
  id                  String   @id @default(uuid())
  name                String
  itemCode            String
  description         String?
  metadata            String?
  itemPollingConfig   String?
  vendor              String
  itemType            String
  communicationPolicy String
  gateway             String?
  icon                String?
  tags                String?
  componentCount      Int      @default(0)
  secureItem          Boolean  @default(false)
  image               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Device {
  id               String   @id @default(uuid())
  name             String
  foreignId        String?  @unique
  gatewayForeignId String?
  serialNumber     String   @unique
  image            String?
  icon             String?
  connectionType   String
  project          String
  metadata         String?
  address          String?
  addressDetails   String?
  houseNo          String?
  block            String?
  street           String?
  city             String?
  state            String?
  country          String?
  zipCode          String?
  status           String   @default("provisioning")
  onboardingVersion Int     @default(0)
  lastProvisionedAt DateTime?
  lastQrGeneratedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollmentQrs    DeviceEnrollmentQr[]
  appClaims        DeviceAppClaim[]
  certificateAssets DeviceCertificateAsset[]
  onboardingQrs    DeviceOnboardingQrAsset[]
  provisioningAudits DeviceProvisioningAudit[]
}

model DeviceCertificateAsset {
  id             String   @id @default(uuid())
  deviceId       String
  version        Int
  thingId        String
  certificateId  String   @unique
  certificateArn String
  bucket         String
  region         String
  certificateKey String
  privateKeyKey  String
  publicKeyKey   String
  metadataKey    String
  status         String   @default("active")
  checksum       String?
  uploadedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  onboardingQrs  DeviceOnboardingQrAsset[]

  @@unique([deviceId, version])
  @@index([deviceId, status])
}

model DeviceOnboardingQrAsset {
  id                 String   @id @default(uuid())
  deviceId           String
  certificateAssetId String?
  version            Int
  bucket             String
  region             String
  objectKey          String
  contentType        String   @default("image/svg+xml")
  checksum           String
  payload            String
  status             String   @default("active")
  generatedAt        DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  device             Device                  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  certificateAsset   DeviceCertificateAsset? @relation(fields: [certificateAssetId], references: [id], onDelete: SetNull)

  @@unique([deviceId, version])
  @@index([deviceId, status])
}

model DeviceProvisioningAudit {
  id                 String   @id @default(uuid())
  deviceId           String?
  workflowId         String
  action             String
  status             String
  deviceSerialNumber String
  thingId            String?
  message            String?
  requestPayload     String?
  responsePayload    String?
  errorPayload       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  device             Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId, createdAt])
  @@index([workflowId, createdAt])
}

model ConsoleApplication {
  id               String   @id @default(uuid())
  name             String
  domain           String
  applicationCode  String
  project          String?
  platform         String?
  applicationType  String?
  description      String?
  image            String?
  icon             String?
  bundleVersion    String?
  authType         String?
  sdkUrl           String?
  bundleUrl        String?
  secretKey        String?
  accessKey        String?
  clientId         String?
  headerKey        String?
  appKey           String   @unique
  status           String   @default("active")
  metadata         String?
  lastClaimedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollmentQrs    DeviceEnrollmentQr[] @relation("EnrollmentIssuer")
  claims           DeviceAppClaim[]

  @@unique([domain, applicationCode])
}

model DeviceEnrollmentQr {
  id               String   @id @default(uuid())
  deviceId         String
  issuedForAppId   String?
  token            String   @unique
  qrType           String   @default("device_claim")
  status           String   @default("pending")
  payload          String?
  expiresAt        DateTime
  claimedAt        DateTime?
  claimedByAppId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  device           Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedForApp     ConsoleApplication? @relation("EnrollmentIssuer", fields: [issuedForAppId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([issuedForAppId])
  @@index([status])
  @@index([expiresAt])
}

model DeviceAppClaim {
  id               String   @id @default(uuid())
  deviceId         String
  appId            String
  enrollmentQrId   String?
  installationId   String?
  alias            String?
  status           String   @default("active")
  metadata         String?
  claimedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  device           Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  app              ConsoleApplication @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([deviceId, appId])
  @@index([deviceId])
  @@index([appId])
  @@index([installationId])
}
