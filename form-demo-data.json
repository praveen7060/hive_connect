      "protocol": "CoAP",
      "messageFormat": "JSON",
      "centric": "PAYLOAD",
      "messageStructure": "{\"moisture\":0,\"temperature\":0}",
      "confirmationMessageStructure": "{\"result\":\"queued\"}",
      "icon": "Sensor",
      "image": "soil-policy.png",
      "needFirmware": true,
      "needConfirmation": false
    },
    {
      "name": "Air Beacon Policy",
