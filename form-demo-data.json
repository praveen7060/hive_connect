  "communication_policies": [
    {
      "name": "EnergyMeter MQTT Policy",
      "groupName": "EnergyOps",
      "itemType": "EnergyMeterPro",
      "protocol": "MQTT",
      "messageFormat": "JSON",
      "centric": "TOPIC",
      "messageStructure": "{\"voltage\":0,\"current\":0,\"power\":0}",
      "confirmationMessageStructure": "{\"ack\":true,\"deviceid\":\"\"}",
