{
  "expo": {
    "name": "Hive Connect Mobile",
    "slug": "hiveconnect",
    "scheme": "hiveconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "extra": {
      "apiBaseUrl": "http://192.168.29.106:4000/api",
      "eas": {
        "projectId": "ff2cdded-5c7c-4a41-94a5-f1cabf2855cf"
      }
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hiveconnect.mobile"
    },
    "android": {
      "package": "com.hiveconnect.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hive Connect Mobile to scan device enrollment QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "bengaltiger"
  }
}
